# OSS AMFA Stack — engine configuration for the local docker-compose environment.
# Copy to .env and adjust:  cp .env.example .env

# PostgreSQL (AMFA engine database, served by the bundled postgres container)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=adaptive_mfa
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=password
POSTGRES_SCHEMA=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# Empty means no password. Set it for a Redis with requirepass, and add
# REDIS_USERNAME for a Redis 6+ ACL user.
REDIS_PASSWORD=
# REDIS_USERNAME=
# TLS to Redis, verifying its certificate and hostname; the CA bundle is only
# needed for a private CA. See docs/environment-variables.md.
# REDIS_SSL=true
# REDIS_SSL_CA_CERTS=/path/to/ca.pem

# --- OIDC / token verification -------------------------------------------------
# The engine only accepts bearer tokens whose issuer is {base}/realms/{realm}
# for one of these comma-separated base URLs, and it fetches the issuer's JWKS
# for signature verification. The base URL must therefore be REACHABLE FROM THE
# ENGINE CONTAINER. Empty = reject everything.
#
# In this compose file both the engine and your browser reach Keycloak at the
# same URL, https://keycloak:8443 (see the `keycloak` hosts-file entry in the
# README Prerequisites) — no split-horizon issuer pinning needed here. Each
# realm's frontendUrl is already set to that same value; see
# docs/keycloak-setup.md for the general (non-bundled) split-horizon case.
OIDC_TRUSTED_BASE_URLS=https://keycloak:8443

# Audience enforcement: every token must carry aud=amfa. This requires an
# audience protocol mapper on the adaptive-auth-api client in EVERY realm that
# calls AMFA (docs/keycloak-setup.md). Only disable if you add role-based
# authorization instead.
OIDC_EXPECTED_AUDIENCE=amfa
OIDC_VERIFY_AUDIENCE=true

# PEM CA bundle the engine trusts for OIDC discovery and JWKS fetches. Required
# when Keycloak uses a private CA (e.g. mkcert). The file is mounted into the
# container by docker-compose.yml. Unset = system trust store only.
OIDC_CA_BUNDLE=/opt/amfa/certs/rootCA.pem

# Dedicated audience for the login-event webhook (/login_event/webhook), kept
# separate from OIDC_EXPECTED_AUDIENCE above. This value MUST match the
# AMFA_WEBHOOK_AUDIENCE the Keycloak container is given below — the webhook
# JWT is hand-built by the AMFA event listener (not issued through a client's
# configured scopes), and this is what stops an ordinary end-user or
# unrelated service-account token from being reshaped into a webhook event.
AMFA_WEBHOOK_AUDIENCE=amfa-webhook-event

# Risk levels: 1=none, 2=OTP, 3=OTP+authenticator, 4=reject.
DEFAULT_RISK_LEVEL=2
# Not currently read on any live evaluation path (a failed evaluation
# returns a server error instead), but must stay >= DEFAULT_RISK_LEVEL --
# the engine refuses to start otherwise (Finding: Insecure Default Fallback
# Risk Level in the Shipped Configuration).
FALLBACK_RISK_LEVEL=3
REJECTED_AUTH_RISK_LEVEL=4

# Event / behaviour window
EVENT_TIME_WINDOW=4
N_ROWS_TO_KEEP=10

# Risk thresholds
GEOLOC_RADIUS=100
TIME_ZONE=UTC

# Signal granularity: when false (default) the browser signal is the browser
# family only ("Chrome") instead of family + major version ("Chrome|150").
# Browsers auto-update often, so including the version makes a routine update
# look like a changed browser/device and needlessly triggers step-up. Set true
# to restore version sensitivity for a high-assurance deployment.
DEVICE_SIGNAL_INCLUDE_BROWSER_VERSION=false

# Rate limiting
RATE_LIMIT=True
RATE_LIMIT_MAX_REQ=4
RATE_LIMIT_TIME_WINDOW=60

# IP reputation (leave empty to disable VPN checks)
IP_HUB_API_KEY=

# Optional tuning
AMFA_TIMEOUT=0.8
RESPONSE_TIMEOUT=5
CACHE_DURATION_DAYS=180
VPN_CACHE_EXPIRATION=86400
GEOLOC_CACHE_EXPIRATION=86400
# Max seconds to wait for an IP-geolocation lookup before falling back to no
# location (0,0). The lookup runs off the event loop, so this is enforced.
GEOLOC_LOOKUP_TIMEOUT=2.0
# Optional ipinfo.io API token to lift the anonymous rate limit. Empty = the
# anonymous endpoint (unchanged behaviour).
IPINFO_TOKEN=
# Dev logging: verbose engine output. LOG_LEVEL accepts a name or number
# (DEBUG = 10, INFO = 20). (DEBUG below is currently unused by the engine.)
LOG_LEVEL=DEBUG
DEBUG=False
